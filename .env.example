# Copy to .env (gitignored) and fill in. scripts/configure and the header helpers read it.
# Keep this file ASCII: the setup commands rewrite .env with ASCII encoding.

# Your Google Cloud project, and the region and Cloud SQL instance Google's demo created there.
CHAI_PROJECT_ID=
CHAI_REGION=asia-south1
CHAI_INSTANCE=chai-and-co-pg

# Host port the Cloud SQL Auth Proxy listens on. The appliance reaches it at
# host.docker.internal:<port>.
CHAI_PROXY_PORT=5433

# The appliance's MCP code door (WORLDS_PORT in the appliance's .env, 11043 by default).
EMBABEL_MCP_URL=http://localhost:11043/mcp/code

# Secrets, filled in by README steps 1 and 6. Never commit them.
CHAI_READER_PASSWORD=
EMBABEL_MCP_TOKEN=
